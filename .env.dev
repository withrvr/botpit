# Local development. Ollama runs natively on Windows; WSL reaches it on localhost
# (mirrored networking). Inside docker compose the app uses host.docker.internal.
BOTPIT_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=sqlite+aiosqlite:///./data/botpit.db
# Compose publishes redis on 6380 and postgres on 5433 (see docker-compose.override.yml).
REDIS_URL=redis://localhost:6380/0
EVENT_BUS=memory

LLM_PROVIDER=ollama_native
LLM_BASE_URL=http://localhost:11434
LLM_MODELS=gemma3:4b,llama3.1:8b,qwen3:4b,phi4-mini:latest
LLM_DEFAULT_MODEL=qwen3:4b
LLM_KEEP_ALIVE=30m
LLM_NUM_CTX=4096
LLM_HEALTH_REQUIRED_AT_STARTUP=true

JWT_SECRET=dev-only-not-a-secret
MAX_CONCURRENT_GAMES=4
MAX_CONNECTIONS=200
MAX_VIEWERS_PER_ROOM=20

LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_SAMPLE_RATE=1.0
LOG_SLOW_REQUEST_MS=1000
