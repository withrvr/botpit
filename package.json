{
  "name": "botpit",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter botpit-frontend dev",
    "lint": "bun run --filter botpit-frontend lint",
    "test": "bun run --filter botpit-frontend test",
    "test:ui": "bun run --filter botpit-frontend test:ui",
    "email:dev": "bun run --filter emails dev",
    "email:export": "bun run --filter emails export"
  }
}
