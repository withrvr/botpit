# Staging: one box, docker compose, Postgres + Redis + llama-server (CPU).
BOTPIT_ENV=staging
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://staging.example.com

DATABASE_URL=postgresql+asyncpg://botpit:CHANGE_ME@postgres:5432/botpit
REDIS_URL=redis://redis:6379/0
EVENT_BUS=redis

LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://llm:8080/v1
LLM_MODELS=qwen3-4b
LLM_DEFAULT_MODEL=qwen3-4b
LLM_HEALTH_REQUIRED_AT_STARTUP=true

JWT_SECRET=CHANGE_ME_64_RANDOM_BYTES
MAX_CONCURRENT_GAMES=2
MAX_CONNECTIONS=100
MAX_VIEWERS_PER_ROOM=10

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SAMPLE_RATE=1.0
LOG_SLOW_REQUEST_MS=1000
